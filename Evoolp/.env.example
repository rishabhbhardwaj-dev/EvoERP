# ── Database ─────────────────────────────────────────────
# PostgreSQL connection string (multi-tenant, shared DB)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/evoerp?schema=public"

# ── Auth (NextAuth v5) ───────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-me-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="EvoERP"
