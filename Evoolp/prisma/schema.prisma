// EvoERP — Prisma schema
// Rule: every tenant-owned model includes `schoolId` (multi-tenancy).
// Indian fiscal year: April to March.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────── Enums ────────────────────────────

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Indian school category (General / SC / ST / OBC).
enum StudentCategory {
  GENERAL
  SC
  ST
  OBC
}

enum StudentStatus {
  ACTIVE
  ALUMNI
  TRANSFERRED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HALF_DAY
}

/// CBSE / Indian school examination types.
enum ExamType {
  PERIODIC_TEST
  HALF_YEARLY
  ANNUAL
  PRACTICE
}

/// CBSE scholastic grade labels (A1 = 91-100%, E = below 33%).
enum GradeLabel {
  A1
  A2
  B1
  B2
  C1
  C2
  D
  E
}

enum FeeCategoryStatus {
  ACTIVE
  INACTIVE
}

enum FeeStructureStatus {
  ACTIVE
  ARCHIVED
}

enum FeeFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum FeeAllocationStatus {
  ASSIGNED
  WAIVED
  CANCELLED
}

enum NoticeAudience {
  ALL
  STUDENTS
  PARENTS
  TEACHERS
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ──────────────────────────── Models ───────────────────────────

model School {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  address   String?
  phone     String?
  email     String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users              User[]
  students           Student[]
  teachers           Teacher[]
  classes            Class[]
  subjects           Subject[]
  enrollments        Enrollment[]
  auditLogs          AuditLog[]
  sections           Section[]
  attendanceSessions AttendanceSession[]
  attendanceRecords  AttendanceRecord[]
  exams              Exam[]
  examResults        ExamResult[]
  reportCardRemarks   ReportCardRemark[]
  coScholasticEntries CoScholasticEntry[]
  feeCategories       FeeCategory[]
  feeStructures       FeeStructure[]
  feeStructureItems   FeeStructureItem[]
  feeDiscounts        FeeDiscount[]
  studentFeeItems     StudentFeeItem[]
  notices             Notice[]

  @@index([status])
}

model User {
  id           String     @id @default(cuid())
  schoolId     String
  name         String
  email        String
  passwordHash String
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  school                   School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherProfile           Teacher?
  studentProfile           Student?
  children                 Student[]           @relation("ParentUser")
  accounts                 Account[]
  sessions                 Session[]
  markedAttendanceSessions AttendanceSession[] @relation("AttendanceMarker")
  createdExams             Exam[]              @relation("ExamCreator")
  enteredResults           ExamResult[]        @relation("ResultEnteredBy")
  authoredRemarks          ReportCardRemark[]
  authoredCoScholastics    CoScholasticEntry[]
  assignedFeeItems         StudentFeeItem[]    @relation("FeeAssigner")
  authoredNotices          Notice[]            @relation("NoticeAuthor")

  @@unique([schoolId, email])
  @@index([schoolId])
  @@index([schoolId, role])
  @@index([schoolId, status])
}

model Student {
  id              String          @id @default(cuid())
  schoolId        String
  /// Admission number is unique per school.
  admissionNumber String
  userId          String?         @unique
  /// Parent (User with role PARENT) linked to this student.
  parentUserId    String?
  firstName       String
  lastName        String
  dateOfBirth     DateTime?       @db.Date
  gender          Gender?
  category        StudentCategory @default(GENERAL)
  /// RTE 25% reservation candidate (Right to Education Act).
  rteCandidate    Boolean         @default(false)
  status          StudentStatus   @default(ACTIVE)
  address         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent            User?             @relation("ParentUser", fields: [parentUserId], references: [id], onDelete: SetNull)
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  examResults       ExamResult[]
  reportCardRemarks   ReportCardRemark[]
  coScholasticEntries CoScholasticEntry[]
  feeItems            StudentFeeItem[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([parentUserId])
}

model Teacher {
  id            String   @id @default(cuid())
  schoolId      String
  userId        String   @unique
  employeeCode  String
  department    String?
  qualification String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, employeeCode])
  @@index([schoolId])
}

model Class {
  id           String   @id @default(cuid())
  schoolId     String
  name         String
  /// Academic year (Indian, Apr-Mar), e.g. "2025-2026".
  academicYear String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections           Section[]
  enrollments        Enrollment[]
  attendanceSessions AttendanceSession[]
  exams              Exam[]
  feeStructures      FeeStructure[]

  @@unique([schoolId, name, academicYear])
  @@index([schoolId])
  @@index([schoolId, academicYear])
}

model Section {
  id       String @id @default(cuid())
  schoolId String
  classId  String
  name     String

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class              Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments        Enrollment[]
  attendanceSessions AttendanceSession[]
  exams              Exam[]
  feeStructures      FeeStructure[]

  @@unique([classId, name])
  @@index([schoolId])
  @@index([classId])
}

model Subject {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exams  Exam[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model Enrollment {
  id           String           @id @default(cuid())
  schoolId     String
  studentId    String
  classId      String
  sectionId    String
  academicYear String
  status       EnrollmentStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class    Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  section  Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  feeItems StudentFeeItem[]

  @@unique([studentId, academicYear])
  @@index([schoolId])
  @@index([schoolId, academicYear])
  @@index([classId])
  @@index([sectionId])
}

model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String
  userId     String
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  createdAt  DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([schoolId, entityType, entityId])
  @@index([userId])
}

model AttendanceSession {
  id           String   @id @default(cuid())
  schoolId     String
  classId      String
  sectionId    String
  academicYear String
  /// Date of attendance without time component (e.g. 2026-09-30)
  date         DateTime @db.Date
  markedById   String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class    Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  section  Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  markedBy User              @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: Restrict)
  records  AttendanceRecord[]

  @@unique([schoolId, classId, sectionId, date])
  @@index([schoolId, date])
  @@index([schoolId, academicYear])
  @@index([classId, sectionId])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  schoolId  String
  sessionId String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  remarks   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  school  School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([schoolId, studentId])
  @@index([studentId, status])
}

/// Exam definition created by ADMIN for a specific class/section/subject/academic year.
model Exam {
  id           String    @id @default(cuid())
  schoolId     String
  classId      String
  sectionId    String
  subjectId    String
  academicYear String
  /// Human-readable exam name, e.g. "Periodic Test 1 - Mathematics".
  name         String
  examType     ExamType
  /// Maximum marks for this exam (Decimal for fractional support, e.g. 25.00, 80.00).
  maxMarks     Decimal   @db.Decimal(6, 2)
  /// Minimum passing marks (admin-entered; must be > 0 and <= maxMarks).
  passingMarks Decimal   @db.Decimal(6, 2)
  /// Optional scheduled exam date (date only, no time).
  examDate     DateTime? @db.Date
  notes        String?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school    School       @relation(fields: [schoolId],  references: [id], onDelete: Cascade)
  class     Class        @relation(fields: [classId],   references: [id], onDelete: Cascade)
  section   Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject   Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy User         @relation("ExamCreator",       fields: [createdById], references: [id], onDelete: Restrict)
  results   ExamResult[]

  /// Prevents duplicate exam names within the same class/section/subject/year per school.
  @@unique([schoolId, classId, sectionId, subjectId, academicYear, name])
  @@index([schoolId])
  @@index([schoolId, academicYear])
  @@index([schoolId, classId, sectionId])
  @@index([subjectId])
}

/// Per-student result for a specific Exam. One row per student per exam (upsert-safe).
model ExamResult {
  id            String     @id @default(cuid())
  schoolId      String
  examId        String
  studentId     String
  /// Raw marks entered by ADMIN or TEACHER (0 .. exam.maxMarks).
  marksObtained Decimal    @db.Decimal(6, 2)
  /// Computed server-side: round((marksObtained / maxMarks) * 100, 2).
  percentage    Decimal    @db.Decimal(5, 2)
  /// Computed server-side CBSE grade label.
  grade         GradeLabel
  /// True when marksObtained >= exam.passingMarks (computed server-side).
  isPassing     Boolean
  remarks       String?
  /// User who last entered or edited these marks.
  enteredById   String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  school    School  @relation(fields: [schoolId],  references: [id], onDelete: Cascade)
  exam      Exam    @relation(fields: [examId],     references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId],  references: [id], onDelete: Cascade)
  enteredBy User    @relation("ResultEnteredBy",    fields: [enteredById], references: [id], onDelete: Restrict)

  /// One result per student per exam.
  @@unique([examId, studentId])
  @@index([schoolId])
  @@index([schoolId, examId])
  @@index([schoolId, studentId])
  @@index([studentId, grade])
}

/// Persistent appraisal remarks entered by teachers/admins for a student's report card.
model ReportCardRemark {
  id           String   @id @default(cuid())
  schoolId     String
  studentId    String
  academicYear String
  /// Canonical cycle identity, e.g. "PERIODIC_TEST::periodic test 1" or "ANNUAL::annual"
  cycleKey     String
  /// Display name of the evaluation cycle, e.g. "Periodic Test 1"
  cycleName    String
  remarks      String   @db.Text
  authorId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school  School  @relation(fields: [schoolId],  references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId],  references: [id], onDelete: Restrict)

  @@unique([schoolId, studentId, academicYear, cycleKey])
  @@index([schoolId, academicYear, cycleKey])
}

/// CBSE Co-Scholastic & Discipline performance grades (A, B, C).
model CoScholasticEntry {
  id           String   @id @default(cuid())
  schoolId     String
  studentId    String
  academicYear String
  term         String   /// "Term 1", "Term 2", "Annual"
  activity     String   /// "WORK_EDUCATION", "ART_EDUCATION", "HEALTH_AND_PHYSICAL_EDUCATION", "DISCIPLINE"
  grade        String   /// "A", "B", "C"
  remarks      String?
  authorId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school  School  @relation(fields: [schoolId],  references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId],  references: [id], onDelete: Restrict)

  @@unique([schoolId, studentId, academicYear, term, activity])
  @@index([schoolId, academicYear, term])
}

// ───────────────────── Finance Management (Stage 1) ─────────────────────

model FeeCategory {
  id          String            @id @default(cuid())
  schoolId    String
  name        String
  code        String
  description String?
  isSystem    Boolean           @default(false)
  status      FeeCategoryStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeStructureItems FeeStructureItem[]
  studentFeeItems   StudentFeeItem[]

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, status])
}

model FeeStructure {
  id           String             @id @default(cuid())
  schoolId     String
  classId      String
  sectionId    String?
  academicYear String
  name         String
  status       FeeStructureStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  school  School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class              @relation(fields: [classId],  references: [id], onDelete: Cascade)
  section Section?           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  items   FeeStructureItem[]

  @@unique([schoolId, classId, sectionId, academicYear, name])
  @@index([schoolId])
  @@index([schoolId, classId, academicYear])
  @@index([schoolId, status])
}

model FeeStructureItem {
  id             String       @id @default(cuid())
  schoolId       String
  feeStructureId String
  feeCategoryId  String
  amount         Decimal      @db.Decimal(10, 2)
  frequency      FeeFrequency
  dueMonth       Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  school          School           @relation(fields: [schoolId],       references: [id], onDelete: Cascade)
  feeStructure    FeeStructure     @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeCategory     FeeCategory      @relation(fields: [feeCategoryId],  references: [id], onDelete: Restrict)
  studentFeeItems StudentFeeItem[]

  @@unique([feeStructureId, feeCategoryId])
  @@index([schoolId])
  @@index([feeStructureId])
  @@index([feeCategoryId])
}

model FeeDiscount {
  id           String            @id @default(cuid())
  schoolId     String
  name         String
  code         String
  type         DiscountType
  value        Decimal           @db.Decimal(10, 2)
  isRteDefault Boolean           @default(false)
  status       FeeCategoryStatus @default(ACTIVE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentFeeItems StudentFeeItem[]

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, status])
}

model StudentFeeItem {
  id                 String              @id @default(cuid())
  schoolId           String
  studentId          String
  enrollmentId       String
  feeStructureItemId String?
  feeCategoryId      String
  academicYear       String
  dueDate            DateTime?           @db.Date
  grossAmount        Decimal             @db.Decimal(10, 2)
  discountId         String?
  discountAmount     Decimal             @db.Decimal(10, 2)
  netAmount          Decimal             @db.Decimal(10, 2)
  remarks            String?
  status             FeeAllocationStatus @default(ASSIGNED)
  assignedById       String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  school           School            @relation(fields: [schoolId],           references: [id], onDelete: Cascade)
  student          Student           @relation(fields: [studentId],          references: [id], onDelete: Cascade)
  enrollment       Enrollment        @relation(fields: [enrollmentId],       references: [id], onDelete: Cascade)
  feeStructureItem FeeStructureItem? @relation(fields: [feeStructureItemId], references: [id], onDelete: SetNull)
  feeCategory      FeeCategory       @relation(fields: [feeCategoryId],      references: [id], onDelete: Restrict)
  discount         FeeDiscount?      @relation(fields: [discountId],         references: [id], onDelete: SetNull)
  assignedBy       User              @relation("FeeAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([schoolId, studentId, academicYear, feeCategoryId, feeStructureItemId])
  @@index([schoolId])
  @@index([schoolId, studentId, academicYear])
  @@index([schoolId, academicYear])
  @@index([studentId, status])
  @@index([enrollmentId])
}

// ─────────────────── NextAuth (Auth.js) adapter tables ───────────────────

model Account {
  id                String  @id @default(cuid())
  schoolId          String
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([schoolId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  schoolId     String
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(cuid())
  schoolId   String
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([schoolId])
}

model Notice {
  id          String         @id @default(cuid())
  schoolId    String
  title       String
  content     String         @db.Text
  audience    NoticeAudience @default(ALL)
  status      NoticeStatus   @default(PUBLISHED)
  publishedAt DateTime       @default(now())
  expiresAt   DateTime?      @db.Date
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy User   @relation("NoticeAuthor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([schoolId])
  @@index([schoolId, status, audience])
  @@index([schoolId, publishedAt])
}
